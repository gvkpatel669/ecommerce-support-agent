SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Prefer a read-only role (USAGE + SELECT on CONFORMED) over ACCOUNTADMIN
SNOWFLAKE_ROLE=ECOMBOT_RO
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ECOMM_DATA_LAKE
SNOWFLAKE_SCHEMA=CONFORMED
LLM_MODEL=MiniMax-M2.7-highspeed
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.chat/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=1024
SNOWFLAKE_QUERY_TIMEOUT_SECONDS=25
# Shared secret required on /chat (X-API-Key or Bearer). Leave empty to run open in local demos.
ECOMBOT_API_KEY=
GIT_COMMIT_SHA=dev
